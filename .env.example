# URL base do projeto no MockAPI.io (recursos: users, scans).
# Sem esta variável, o app usa um adaptador local (localStorage) que simula a mesma API.
VITE_MOCKAPI_URL=

# Opcional: chave gratuita da Google Books API (Google Cloud Console).
# Sem ela a cota anônima é compartilhada; o app cai automaticamente para a Open Library.
VITE_GOOGLE_BOOKS_API_KEY=
